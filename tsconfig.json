{
  "compilerOptions": {
    "target": "es2024",
    "module": "commonjs",
    "paths": {
      "@globalVariable": ["./globalVariables.ts"],
      "@index": ["./index.ts"],
      "@pageObjects/*": ["./supports/pageObjects/*"],
      "@constants/*": ["./supports/constants/*"],
      "@resources/*": ["./resources/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  }
}
